DB_NAME=finbridge
DB_USER=finbridge
DB_PASSWORD=replace-me-local-only
DB_HOST=localhost
DB_PORT=5433
SERVER_PORT=8080

# Fondeo exclusivamente local, además requiere rol ADMIN.
SANDBOX_FUNDING_ENABLED=false
JWT_ISSUER=http://localhost:8180/realms/finbridge
JWT_JWK_SET_URI=http://localhost:8180/realms/finbridge/protocol/openid-connect/certs
JWT_AUDIENCE=finbridge-api

# External simulator is disabled until a local secret is configured.
PROVIDER_HMAC_SECRET=
PROVIDER_WORKER_ENABLED=false
